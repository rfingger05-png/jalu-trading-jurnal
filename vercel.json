{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "server.js,dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts?path=$1" },
    { "source": "/api", "destination": "/api/index.ts" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
